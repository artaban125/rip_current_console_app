<Window x:Class="RipCurrentConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이안류 및 수영객 AI 실시간 관제 콘솔" Height="850" Width="1400"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen"
        FontFamily="Pretendard, Malgun Gothic, Segoe UI"
        SizeChanged="Window_SizeChanged">

    <!-- ================================================================= -->
    <!-- [XAML 리소스] 버튼 및 UI 템플릿 스타일 정의                        -->
    <!-- ================================================================= -->
    <Window.Resources>
        <!-- ⭐️ 1줄 인라인용 초슬림 미니 확인 버튼 스타일 -->
        <Style x:Key="SlimConfirmButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#31748F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#31748F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- [컬럼 0] 좌측 메인 관제 화면 (기본 8비율) -->
            <ColumnDefinition x:Name="ColVideo" Width="8*" MinWidth="600"/>

            <!-- [컬럼 1] 마우스 조절용 구분선 (GridSplitter) -->
            <ColumnDefinition Width="10"/>

            <!-- [컬럼 2] 우측 스냅샷 및 제어 패널 (기본 2비율, 최대 30% 제한) -->
            <ColumnDefinition x:Name="ColGallery" Width="2*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- [좌측] 상단 알림바 + 메인 동영상 관제 화면                         -->
        <!-- ================================================================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 실시간 3단계 상태 알림바 (관찰 / 경고 / 긴급) -->
            <Border x:Name="AlertBanner" Grid.Row="0" Height="42" Margin="0,0,0,8"
                    Background="#1A2C26" CornerRadius="8" BorderThickness="1" BorderBrush="#A6E3A1"
                    Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BadgeLevel" Grid.Column="0" CornerRadius="4" Padding="10,3"
                            Background="#A6E3A1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtLevelBadge" Text="관찰" FontWeight="Bold" FontSize="14" Foreground="#11111B"/>
                    </Border>

                    <TextBlock x:Name="TxtBannerDetails" Grid.Column="1" 
                               Text="이안류 없음  |  대기 중" 
                               Foreground="#A6E3A1" FontWeight="SemiBold" FontSize="14" 
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 메인 동영상 뷰어 -->
            <Border Grid.Row="1" Background="#11111B" CornerRadius="10" BorderBrush="#313244" BorderThickness="1" 
                    ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="MainVideoPlayer_MouseLeftButtonDown">
                <Grid>
                    <Image x:Name="MainVideoPlayer" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" 
                               Text="CCTV 준비중" 
                               Foreground="#A6ADC8" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- 안내 뱃지 -->
                    <Border Background="#80000000" CornerRadius="4" Padding="8,4" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="🔍 화면 클릭 시 최근 스냅샷 확인" Foreground="#CDD6F4" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- [중앙] 마우스 드래그 리사이저 (GridSplitter)                       -->
        <!-- ================================================================= -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#45475A" Cursor="SizeWE" ShowsPreview="False">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border Background="Transparent">
                        <Border Width="2" Background="#45475A" CornerRadius="1"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- ================================================================= -->
        <!-- [우측] 제어 버튼 및 반응형 스냅샷 갤러리                          -->
        <!-- ================================================================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제어 버튼 패널 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Button x:Name="BtnLoadVideo" 
                        Content="📁 이안류 감시 준비" 
                        Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Background="#45475A" Foreground="White" BorderThickness="0" 
                        Margin="0,0,0,8"
                        Click="BtnLoadVideo_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnToggleSurveillance" 
                        Content="🚨 이안류 감시 시작" 
                        Height="44" FontSize="14" FontWeight="Bold" Cursor="Hand"
                        Background="#F38BA8" Foreground="#11111B" BorderThickness="0" 
                        IsEnabled="False" Margin="0,0,0,8"
                        Click="BtnToggleSurveillance_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnOpenLogViewer" Grid.Column="0"
                            Content="📑 관제 로그" 
                            Height="38" FontSize="13" FontWeight="Bold" Cursor="Hand"
                            Background="#89B4FA" Foreground="#11111B" BorderThickness="0" 
                            Click="BtnOpenLogViewer_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnOpenSettings" Grid.Column="2"
                            Content="⚙ 환경설정" 
                            Height="38" FontSize="13" FontWeight="Bold" Cursor="Hand"
                            Background="#CBA6F7" Foreground="#11111B" BorderThickness="0" 
                            Click="BtnOpenSettings_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <Separator Margin="0,6,0,8" Background="#313244"/>

                <TextBlock Text="🚨 위험 구역 침범 스냅샷" 
                           Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" Margin="0,2,0,4"/>
            </StackPanel>

            <!-- 스냅샷 스크롤 갤러리 -->
            <Border Grid.Row="1" Background="#11111B" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel x:Name="SnapshotGallery" Orientation="Vertical"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 모달 팝업 레이어 -->
        <Grid x:Name="SnapshotPopupModal" Grid.ColumnSpan="3" Background="#D911111B" Visibility="Collapsed">
            <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1.5"
                    MaxWidth="1000" MaxHeight="720" Margin="40" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtModalTitle" Text="🚨 최근 긴급 스냅샷 상세 분석" 
                                   Foreground="#F38BA8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕ 닫기" Width="80" Height="32" HorizontalAlignment="Right"
                                Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"
                                Click="BtnCloseModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#11111B" CornerRadius="8" ClipToBounds="True">
                        <Image x:Name="ModalImagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>