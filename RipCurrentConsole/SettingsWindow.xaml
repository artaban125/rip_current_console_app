<Window x:Class="RipCurrentConsole.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="관제 AI 및 필터링 환경설정" Height="620" Width="680"
        Background="#1E1E2E" WindowStartupLocation="CenterOwner"
        FontFamily="Pretendard, Malgun Gothic, Segoe UI" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <TextBlock Grid.Row="0" Text="⚙ AI 추론 및 필터링 정밀 설정" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- 설정 본문 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <!-- 그룹 1: 이안류 모델 -->
                <Border Background="#11111B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🌊 이안류(Rip Current) 모델 설정" Foreground="#89B4FA" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Confidence 임계값 (0.01 ~ 1.0):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderRipConf" Grid.Column="1" Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRipConf" Grid.Column="2" Text="{Binding Value, ElementName=SliderRipConf, StringFormat={}{0:F2}}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IOU 임계값 (0.1 ~ 1.0):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderRipIou" Grid.Column="1" Minimum="0.1" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRipIou" Grid.Column="2" Text="{Binding Value, ElementName=SliderRipIou, StringFormat={}{0:F2}}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 그룹 2: 수영객 모델 -->
                <Border Background="#11111B" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🏊 수영객(Swimmer) 모델 설정" Foreground="#A6E3A1" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Confidence 임계값 (0.01 ~ 1.0):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderSwimmerConf" Grid.Column="1" Minimum="0.01" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSwimmerConf" Grid.Column="2" Text="{Binding Value, ElementName=SliderSwimmerConf, StringFormat={}{0:F2}}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IOU 임계값 (0.1 ~ 1.0):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderSwimmerIou" Grid.Column="1" Minimum="0.1" Maximum="1.0" SmallChange="0.01" LargeChange="0.05" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSwimmerIou" Grid.Column="2" Text="{Binding Value, ElementName=SliderSwimmerIou, StringFormat={}{0:F2}}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 그룹 3: 사고 세션 및 필터링 -->
                <Border Background="#11111B" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⏱ 사고 세션 및 중복 방지 필터" Foreground="#F38BA8" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="동일 구역 재캡처 억제 시간 (초):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderSameAreaSec" Grid.Column="1" Minimum="3.0" Maximum="30.0" SmallChange="1.0" LargeChange="2.0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSameAreaSec" Grid.Column="2" Text="{Binding Value, ElementName=SliderSameAreaSec, StringFormat={}{0:F1}s}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="완전 무위험 시 세션 종료 (초):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderClearDelaySec" Grid.Column="1" Minimum="1.0" Maximum="15.0" SmallChange="0.5" LargeChange="1.0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtClearDelaySec" Grid.Column="2" Text="{Binding Value, ElementName=SliderClearDelaySec, StringFormat={}{0:F1}s}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="동일인 판정 반경 거리 (px):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderSpatialDist" Grid.Column="1" Minimum="50.0" Maximum="500.0" SmallChange="10.0" LargeChange="50.0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSpatialDist" Grid.Column="2" Text="{Binding Value, ElementName=SliderSpatialDist, StringFormat={}{0:F0}px}" 
                                     Background="#313244" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalAlignment="Center" Height="24"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 하단 액션 버튼 -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="🔄 기본값 복원" Width="120" Height="36" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand" Click="BtnReset_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Width="90" Height="36" Background="#45475A" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="💾 설정 저장" Width="110" Height="36" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>