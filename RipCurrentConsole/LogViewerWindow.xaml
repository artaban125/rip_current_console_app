<Window x:Class="RipCurrentConsole.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이안류 관제 긴급 로그 이력" Height="700" Width="1250"
        Background="#1E1E2E" WindowStartupLocation="CenterOwner"
        FontFamily="Pretendard, Malgun Gothic, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📋 긴급 조난 관제 로그 이력" Foreground="#CDD6F4" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🔄 새로고침" Width="100" Height="36" Background="#45475A" Foreground="White" 
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnRefresh_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- 로그 테이블 (DataGrid) -->
        <Border Grid.Row="1" Background="#11111B" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" Padding="6">
            <DataGrid x:Name="GridLogs" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                      Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                      BorderThickness="0" CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" RowHeight="38" FontSize="13">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#313244"/>
                        <Setter Property="Foreground" Value="#CDD6F4"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#45475A"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}" x:Key="CenterText">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No" Binding="{Binding Id}" Width="55" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="발생 시각" Binding="{Binding CreatedAt}" Width="155" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="위험 등급" Binding="{Binding DangerLevel}" Width="85" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="이안류 수" Binding="{Binding RipCount}" Width="80" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="위험 인원" Binding="{Binding DangerCount}" Width="80" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="전체 인원" Binding="{Binding TotalCount}" Width="80" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="영상 위치(초)" Binding="{Binding TimestampSec, StringFormat={}{0:F1}s}" Width="105" ElementStyle="{StaticResource CenterText}"/>

                    <!-- 클릭 가능한 분석 이미지 파일명 -->
                    <DataGridTemplateColumn Header="분석 이미지 (클릭 시 확대)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ImageFileName}" 
                                        Background="Transparent" BorderThickness="0" 
                                        Foreground="#89B4FA" Cursor="Hand" FontWeight="SemiBold"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                        Click="BtnImageLink_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="경보 사유" Binding="{Binding AlertReason}" Width="85" ElementStyle="{StaticResource CenterText}"/>
                    <DataGridTextColumn Header="발송 상태" Binding="{Binding DispatchStatus}" Width="100" ElementStyle="{StaticResource CenterText}"/>

                    <!-- ⭐️ 관리자 확인 여부 컬럼 -->
                    <DataGridTextColumn Header="확인 여부" Binding="{Binding IsConfirmed}" Width="95" ElementStyle="{StaticResource CenterText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 이미지 확대 팝업 모달 레이어 -->
        <Grid x:Name="ImageModal" Grid.RowSpan="2" Background="#E611111B" Visibility="Collapsed">
            <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1.5"
                    MaxWidth="950" MaxHeight="680" Margin="40" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtModalTitle" Text="🚨 분석 스냅샷 원본" 
                                   Foreground="#F38BA8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕ 닫기" Width="80" Height="32" HorizontalAlignment="Right"
                                Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"
                                Click="BtnCloseModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#11111B" CornerRadius="8" ClipToBounds="True">
                        <Image x:Name="ModalPreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>